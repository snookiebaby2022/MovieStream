PORT=3001
NODE_ENV=production
TMDB_API_KEY=your_tmdb_key
MONGODB_URI=mongodb://127.0.0.1:27017/moviestream
REDIS_URL=redis://127.0.0.1:6379
SITE_URL=https://snookiebaby.xyz:8443
ADMIN_USER=admin
ADMIN_PASS=change_this_strong_password
JWT_SECRET=generate_a_long_random_string

# ── Premium debrid (site-wide — at least one required for streams) ──
# Real-Debrid (you already have this)
REALDEBRID_API_TOKEN=
# Optional extras — each increases cached-hit coverage (see docs/PREMIUM_SETUP.md)
ALLDEBRID_API_TOKEN=
PREMIUMIZE_API_TOKEN=
TORBOX_API_TOKEN=

# Stremio addon hosts
# TORRENTIO_URL=https://torrentio.strem.fun
# COMET_URL=https://comet.elfhosted.com
# MEDIAFUSION_URL=https://mediafusion.elfhosted.com
# Encrypted config path from MediaFusion “Share Manifest URL”
# MEDIAFUSION_CONFIG=
# AIOStreams base URL (manifest without /manifest.json), e.g.
# https://aiostreams.elfhosted.com/stremio/<your-id>
# AIOSTREAMS_BASE_URL=

# Optional SMTP for password-reset emails (otherwise reset link is returned in API response)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=0

# Stripe — £1/month Premium subscription (https://dashboard.stripe.com)
# 1) Create Product “FlixNova Premium” → recurring Price £1 GBP / month
# 2) Paste Price ID (price_…) below (optional — without it Checkout uses inline price_data)
# 3) Set Secret key + webhook secret (events: checkout.session.completed,
#    customer.subscription.*, invoice.paid, invoice.payment_failed)
# 4) Set SITE_URL to your public site URL
# 5) pm2 restart moviestream --update-env
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ADFREE_PRICE_PENCE=100
ADFREE_CURRENCY=gbp

# Optional Google AdSense client id (unused when entitled)
# ADSENSE_CLIENT=
