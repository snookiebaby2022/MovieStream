PORT=3001
NODE_ENV=production
TMDB_API_KEY=your_tmdb_key
MONGODB_URI=mongodb://127.0.0.1:27017/moviestream
REDIS_URL=redis://127.0.0.1:6379
SITE_URL=https://snookiebaby.xyz:8443
ADMIN_USER=admin
ADMIN_PASS=change_this_strong_password
JWT_SECRET=generate_a_long_random_string

# Real-Debrid (recommended for ad-free / no-popup playback)
# Option A: set site-wide token so every visitor gets RD streams:
REALDEBRID_API_TOKEN=
# Option B: leave empty — users paste their own token via the RD button.

# Optional SMTP for password-reset emails (otherwise reset link is returned in API response)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=0

# Stripe — one-time £1 "Remove ads" (https://dashboard.stripe.com/apikeys)
# 1) Create Stripe account (UK) and activate payments
# 2) Copy Secret key (sk_test_... while testing, sk_live_... in production)
# 3) Set SITE_URL to your public site URL
# 4) Restart: pm2 restart moviestream --update-env
# 5) Click "Ad-Free £1" on the site to test Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADFREE_PRICE_PENCE=100
ADFREE_CURRENCY=gbp

# Optional Google AdSense client id for free users (e.g. ca-pub-xxxxxxxx)
# ADSENSE_CLIENT=
