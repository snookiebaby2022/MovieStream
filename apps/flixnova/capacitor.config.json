{
  "appId": "xyz.snookiebaby.flixnova",
  "appName": "FlixNova",
  "webDir": "www",
  "server": {
    "url": "https://snookiebaby.xyz",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "snookiebaby.xyz",
      "*.snookiebaby.xyz",
      "image.tmdb.org",
      "*.tmdb.org",
      "www.youtube-nocookie.com",
      "*.stripe.com",
      "checkout.stripe.com",
      "*.real-debrid.com",
      "real-debrid.com",
      "*.cdn.real-debrid.com",
      "torrentio.strem.fun",
      "comet.elfhosted.com",
      "*.elfhosted.com",
      "mediafusion.elfhosted.com",
      "*.download.real-debrid.com",
      "*.jsdelivr.net",
      "cdn.jsdelivr.net"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0a0a0a",
    "buildOptions": {
      "keystorePath": "",
      "keystoreAlias": ""
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0a0a0a",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0a"
    }
  }
}
